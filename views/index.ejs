<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="An unofficial fan message board for Hello Kitty fans to share memories, merch finds, and all things cute.">
  <title>Hello Kitty Fan Board</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,800;1,800&family=Pacifico&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <!-- Reusable icons -->
  <svg class="icon-sprite" aria-hidden="true">
    <symbol id="i-sparkle" viewBox="0 0 24 24">
      <path d="M12 1c.9 6.2 4.8 10.1 11 11-6.2.9-10.1 4.8-11 11-.9-6.2-4.8-10.1-11-11 6.2-.9 10.1-4.8 11-11z" />
    </symbol>
    <symbol id="i-heart" viewBox="0 0 24 24">
      <path d="M12 21C5.5 15.6 2 12.2 2 8.3 2 5.4 4.2 3.3 6.9 3.3c2 0 3.6 1.1 5.1 3 1.5-1.9 3.1-3 5.1-3 2.7 0 4.9 2.1 4.9 5 0 3.9-3.5 7.3-10 12.7z" />
    </symbol>
    <symbol id="i-shell" viewBox="0 0 24 24">
      <path d="M12 3C6 3 2.5 7.6 3 13.2L12 21l9-7.8C21.5 7.6 18 3 12 3z" />
      <path class="shell-lines" d="M12 6v13M8 7l2.6 11.6M16 7l-2.6 11.6M5 10l5.4 9M19 10l-5.4 9" />
    </symbol>
    <symbol id="i-flower" viewBox="0 0 24 24">
      <circle cx="12" cy="5.5" r="4" /><circle cx="18.2" cy="10" r="4" /><circle cx="15.8" cy="17.4" r="4" />
      <circle cx="8.2" cy="17.4" r="4" /><circle cx="5.8" cy="10" r="4" />
      <circle class="flower-center" cx="12" cy="12" r="3.2" />
    </symbol>
    <symbol id="i-palm" viewBox="0 0 24 24">
      <path class="palm-trunk" d="M12.5 11c.6 4 .4 8-.8 11.5" />
      <path d="M12.5 11C10 7 6 6 2.5 8c3-.2 6 .6 10 3zM12.5 11c1.8-4.3 5.6-6 9.5-4.6-3 .3-6 1.7-9.5 4.6zM12.5 11C12 6.5 9.5 3.5 6 2.5c2.3 2 4.7 4.6 6.5 8.5zM12.5 11c2.3-3.6 5.6-5 9-3.8" />
    </symbol>
  </svg>

  <header class="hero">
    <svg class="float float-1" aria-hidden="true"><use href="#i-sparkle" /></svg>
    <svg class="float float-2" aria-hidden="true"><use href="#i-heart" /></svg>
    <svg class="float float-3" aria-hidden="true"><use href="#i-shell" /></svg>
    <svg class="float float-4" aria-hidden="true"><use href="#i-palm" /></svg>

    <div class="container hero-inner">
      <p class="eyebrow">✦ Unofficial fan message board ✦</p>
      <h1>Hello Kitty</h1>
      <p class="hero-sub">Fan Board</p>
      <p class="tagline">Share your favorite memories, merch finds, café trips, and all things cute with other fans.</p>
    </div>
  </header>

  <% const icons = ["sparkle", "heart", "palm", "flower", "shell"]; %>
  <div class="pattern-band" aria-hidden="true">
    <% for (let i = 0; i < 30; i++) { %>
      <svg class="band-icon band-<%= icons[i % icons.length] %>"><use href="#i-<%= icons[i % icons.length] %>" /></svg>
    <% } %>
  </div>

  <main class="container layout">
    <section class="card post-card" aria-labelledby="post-title">
      <h2 id="post-title">Leave a message <svg class="title-icon" aria-hidden="true"><use href="#i-heart" /></svg></h2>

      <% if (error === "empty") { %>
        <p class="form-error" role="alert">Please add your name and a message before posting.</p>
      <% } %>

      <form action="/messages" method="POST" id="message-form">
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" placeholder="e.g. Mimi" maxlength="<%= maxName %>" required autocomplete="nickname">

        <label for="topic">Topic</label>
        <select id="topic" name="topic">
          <% topics.forEach((item) => { %>
            <option value="<%= item.id %>" <%= item.id === topic ? "selected" : "" %>><%= item.emoji %> <%= item.label %></option>
          <% }) %>
        </select>

        <label for="msg">Message</label>
        <textarea id="msg" name="msg" rows="4" placeholder="What's your favorite Hello Kitty memory? ✨" maxlength="<%= maxMessage %>" required></textarea>
        <p class="char-count" id="char-count" aria-live="polite">0 / <%= maxMessage %></p>

        <button type="submit" class="btn-post">Post message</button>
      </form>
    </section>

    <section class="board" aria-labelledby="board-title">
      <div class="board-header">
        <h2 id="board-title">Messages <span class="count-pill" id="message-count"><%= messages.length %></span></h2>

        <nav class="sort-toggle" aria-label="Sort messages">
          <a href="<%= link({ sort: 'newest' }) %>" class="<%= sort === 'newest' ? 'active' : '' %>">Newest</a>
          <a href="<%= link({ sort: 'top' }) %>" class="<%= sort === 'top' ? 'active' : '' %>">Most loved</a>
        </nav>
      </div>

      <nav class="topic-filter" aria-label="Filter by topic">
        <a href="<%= link({ topic: '' }) %>" class="topic-chip <%= topic ? '' : 'active' %>">All topics</a>
        <% topics.forEach((item) => { %>
          <a href="<%= link({ topic: item.id }) %>" class="topic-chip topic-<%= item.id %> <%= item.id === topic ? 'active' : '' %>"><%= item.emoji %> <%= item.label %></a>
        <% }) %>
      </nav>

      <p class="empty-state <%= messages.length ? 'hidden' : '' %>" id="empty-state">
        <svg aria-hidden="true"><use href="#i-sparkle" /></svg>
        <%= topic ? "No messages in this topic yet. Start the conversation!" : "No messages yet. Be the first to say hi!" %>
      </p>

      <ul class="messages" id="messages">
        <% messages.forEach((message, index) => { %>
          <li class="message tone-<%= index % 4 %>" data-id="<%= message._id %>">
            <div class="message-top">
              <span class="avatar" aria-hidden="true"><%= (message.name || "?").charAt(0).toUpperCase() %></span>
              <div>
                <p class="message-name"><%= message.name %></p>
                <p class="message-time"><%= timeAgo(message._id.getTimestamp()) %></p>
              </div>
            </div>

            <% const messageTopic = topicById[message.topic]; %>
            <% if (messageTopic) { %>
              <a href="<%= link({ topic: messageTopic.id }) %>" class="topic-chip topic-<%= messageTopic.id %> message-topic"><%= messageTopic.emoji %> <%= messageTopic.label %></a>
            <% } %>

            <p class="message-text"><%= message.msg %></p>

            <div class="message-actions">
              <button type="button" class="action action-up" data-action="up" aria-label="Love this message">
                <i class="fa fa-heart" aria-hidden="true"></i>
              </button>
              <span class="score" aria-label="Score"><%= message.thumbUp ?? 0 %></span>
              <button type="button" class="action action-down" data-action="down" aria-label="Not for me">
                <i class="fa fa-thumbs-down" aria-hidden="true"></i>
              </button>
              <button type="button" class="action action-delete" data-action="delete" aria-label="Delete message">
                <i class="fa fa-trash" aria-hidden="true"></i>
              </button>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>

  <footer class="footer">
    <p>Made with <svg aria-hidden="true"><use href="#i-heart" /></svg> using Node.js, Express, MongoDB &amp; EJS</p>
    <p class="footer-note">An unofficial fan project. Hello Kitty is a trademark of Sanrio Co., Ltd. This site isn't affiliated with or endorsed by Sanrio.</p>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script src="main.js"></script>
</body>
</html>
